#!/usr/bin/env bash
# JustSpeak CLI Runner
#
# Concatenates src/*.swift (lexical order) into one generated script and interprets it with
# the Apple-signed Swift toolchain - no compiled binary is ever produced, so Santa never has
# anything to block. #sourceLocation directives are injected at each file boundary so compiler
# diagnostics point at the real src/ file and line, not the generated blob.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GEN_DIR="${SCRIPT_DIR}/.build"
GEN="${GEN_DIR}/justspeak.gen.swift"

mkdir -p "${GEN_DIR}"
: > "${GEN}"

first=1
for f in "${SCRIPT_DIR}"/src/*.swift; do
  rel="src/$(basename "$f")"
  if [ "$first" -eq 1 ]; then
    # The first file carries the shebang, which must stay on line 1; it is first in
    # lexical order, so its diagnostics line up 1:1 without a directive.
    first=0
  else
    printf '#sourceLocation(file: "%s", line: 1)\n' "$rel" >> "${GEN}"
  fi
  cat "$f" >> "${GEN}"
done

# The interpreted script's argv[0] is the generated file inside .build/, so Config.load
# can't find .env/vocabulary beside the runner from it; hand it the real home instead.
export JUSTSPEAK_HOME="${SCRIPT_DIR}"

# Build identity for the banner and history rows: short SHA (or tag-relative describe),
# "-dirty" when the working tree has local edits. Empty when git or the repo is absent.
JUSTSPEAK_BUILD="$(git -C "${SCRIPT_DIR}" describe --always --dirty --tags 2>/dev/null || true)"
export JUSTSPEAK_BUILD

exec /usr/bin/swift "${GEN}" "$@"
