# JustSpeak Configuration
# ========================

# Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# REST Fallback Model (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Live WebSocket Model (Real-Time Bidirectional Streaming)
# Dedicated STT Foundation Model: gemini-3.5-transcribe-live
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Smart Transcription (gemini-3.5-transcribe-live only)
# Enables real-time Inverse Text Normalization ($26M, dates), disfluency removal (um/uh), and smart formatting
SMART_TRANSCRIPTION=true

# Language Codes (Target / Prioritized Speech Languages)
# Comma-separated REGION-QUALIFIED BCP-47 codes from the live-transcribe language table,
# e.g. en-IN,mr-IN,hi-IN or en-US,es-ES. Casing is normalized automatically (en-in -> en-IN).
# Default: en-IN,mr-IN (English & Marathi, India). Set to 'auto' for auto-detection (80+ languages).
LANGUAGE_CODES=en-IN,mr-IN

# Custom Vocabulary (Domain terms, acronyms, company jargon, proper nouns)
# Comma-separated list of words/phrases to boost speech recognition accuracy
# An item containing "=>" is a deterministic replacement rule instead of a boost term:
#   cooper netties => Kubernetes
CUSTOM_VOCABULARY=

# Custom Vocabulary File (Optional)
# Relative or absolute path to a text file containing words/phrases (one per line, '#' comments allowed)
# Defaults to auto-loading 'vocabulary.txt' if present in the workspace
CUSTOM_VOCABULARY_FILE=vocabulary.txt

# Push-to-Talk Hotkey
# Options:
#   - fn             (Default - Fn / Globe key, keyCode 63; set System Settings > Keyboard >
#                     "Press 🌐 key to" > Do Nothing, and turn off Apple Dictation's Fn shortcut)
#   - right_option   (Right Option/Alt key, keyCode 61)
#   - left_option    (Left Option/Alt key, keyCode 58)
#   - right_control  (Right Control key, keyCode 62)
#   - left_control   (Left Control key, keyCode 59)
#   - right_cmd      (Right Command key, keyCode 54)
#   - left_cmd       (Left Command key, keyCode 55)
#   - f18            (F18 key, keyCode 0x4F)
#   - f19            (F19 key, keyCode 0x50)
#   - f13            (F13 key, keyCode 0x69)
HOTKEY=fn

# Hotkey Trigger Mode
# Options:
#   - push_to_talk   (Hold key down to speak, release to commit and inject)
#   - toggle         (Press key once to start recording, press again to stop)
HOTKEY_MODE=push_to_talk

# Hold to Lock
# Keep holding the hotkey this many seconds and the turn locks: a ring traces the pill's
# rim while you hold, and once it closes you can let go - the mic stays open until you press
# the hotkey again. For long dictations. 0 disables; ignored in toggle mode.
HOLD_TO_LOCK=12

# Lock Limit
# Seconds a locked turn may run before it finishes on its own (a forgotten open mic).
LOCK_LIMIT=120

# Audio Feedback
# Play subtle macOS system sounds on recording start and text injection
SOUND_FEEDBACK=true

# Release Acknowledgment Tick
# Soft tick at key release - confirms the hold ended while the transcript settles (on a slow
# REST fallback there are otherwise seconds of silence before the commit sound). Needs
# SOUND_FEEDBACK=true.
RELEASE_SOUND=true

# Native Floating Pill HUD
# Display a floating glassmorphic Dynamic Island pill overlay on the screen
SHOW_HUD=true

# HUD Follow Focus
# Show the HUD on the display holding the frontmost app's focused window (so the external
# monitor's pill lights up when you dictate there, not the laptop's notch). false = always
# the menu-bar/notch display.
HUD_FOLLOW_FOCUS=true

# HUD Particle Motes
# Ambient light-dust drifting down from the notch while listening, breathing with your voice
# (GPU-composited CAEmitterLayer; automatically disabled under macOS Reduce Motion).
HUD_PARTICLES=true

# Privacy Mode (screen sharing)
# The pill is hidden entirely - the notch aura (color cycle while listening, green on paste,
# red on error) and the earcons carry all feedback - and the terminal prints a character
# count instead of the dictation. The paste still happens normally and the local history DB
# still records (set HISTORY=false to stop that too).
PRIVACY_MODE=false

# HUD Entrance Animation
# Options:
#   - slide    (Default - slides out from beneath the notch)
#   - bloom    (Inflates from the notch while fading in, soft overshoot)
#   - drift    (Barely moves: fades in while drifting the last few points - the most understated)
#   - unfurl   (Unrolls downward past its height and settles back - the bounciest)
#   - morph    (Dynamic Island membrane: a black droplet stretches out of the notch itself,
#               detaches, and settles into the pill. Needs a physical notch; falls back to
#               slide on external displays)
# Preview all states without dictating: make hud-demo
HUD_REVEAL=slide

# Input Device (microphone)
# Empty = the system default input, which macOS may silently switch to an external display's
# mic (Studio Display etc.). "auto" = the built-in mic while the lid is open, an external
# (physical) mic while it's closed - switches on lid flips, deferred past an in-flight turn.
# Or pin one with its CoreAudio UID or any part of its name (case-insensitive: "studio",
# "MacBook Pro Microphone"). List candidates and what auto would pick: make list-inputs
# The startup log and every history row record which device was actually used.
INPUT_DEVICE=

# System Output Ducking
# Lower the Mac's output volume while recording so music/video on speakers doesn't bleed into
# the mic (hurting accuracy and billing audio tokens for it). Restored when capture ends; if
# you change the volume mid-dictation yourself, your change wins and nothing is restored.
DUCK_AUDIO=false

# Fraction of the current output volume kept while ducked (0.0-1.0). 0.2 = drop to 20%.
DUCK_FRACTION=0.2

# Real-time WebSocket Streaming
# Stream audio chunks directly to Gemini Live API over WebSockets while speaking
ENABLE_LIVE_WEBSOCKET=true

# Restore Previous Clipboard
# Automatically restore user's previous clipboard contents ~1s after injection,
# only if nothing else has written the clipboard in the meantime
RESTORE_CLIPBOARD=true

# Trailing Space
# Append one space after each injected dictation so back-to-back dictations don't fuse
# ("...are you?Are you..."). Logs, HUD, and history show the unpadded text.
TRAILING_SPACE=true

# REST Fallback Timeout (seconds)
# Maximum time to wait for WebSocket response before falling back to REST
REST_FALLBACK_TIMEOUT=2.5

# Pre-Roll Buffer (milliseconds)
# Rolling acoustic ring buffer maintained while idle. When the hotkey is pressed, this head-start
# audio is instantly dispatched to prevent clipping the first spoken syllable. 0-1000. Default: 400.
PRE_ROLL_MS=400

# Post-Roll Grace Period (milliseconds)
# Adaptive trailing capture: after key release, audio keeps streaming while speech energy is
# still present, and this is the continuous-quiet window required before the turn commits
# (people release the key while still finishing the last syllable). Lower = faster commit on
# an already-quiet release; too low clips the final word. 0-500. Default: 250.
POST_ROLL_MS=250

# Post-Roll Hard Cap (milliseconds)
# Upper bound on the adaptive trailing capture above, regardless of ongoing speech energy.
# Set equal to POST_ROLL_MS (or 0) to disable adaptation and always use the fixed post-roll.
# 0-5000. Default: 1500.
POST_ROLL_MAX_MS=1500

# Trailing Silence Threshold (dBFS)
# RMS level below which the mic is considered quiet for the adaptive trailing capture above.
# Speech is typically -30 to -15 dB; room noise -50 to -60 dB on this meter. -80.0 to -10.0.
# Default: -40.0.
TRAIL_SILENCE_DB=-40.0

# Voice Activity Detection Mode (Gemini Live)
# Options:
#   - manual  (Default & recommended for push-to-talk: the key hold defines the speech window,
#              server VAD is disabled - a mid-sentence pause can never cut off transcription)
#   - tuned   (Server VAD stays on but is made pause-tolerant via VAD_SILENCE_MS; experimental)
#   - auto    (Stock server VAD; fallback if the model rejects the manual/tuned configuration -
#              a rejection appears as a "[WS] Server error" line in the terminal)
VAD_MODE=manual

# VAD Silence Window (milliseconds, tuned mode only)
# How long a pause must last before server VAD declares end-of-speech. 200-5000.
VAD_SILENCE_MS=1500

# --- Protocol A/B knobs (defaults = shipped behavior; flip one at a time and compare the
# --- per-turn latency diagnostics + last-word accuracy before adopting) ---

# Aligned End-of-Turn Signaling (transcribe models only)
# false (default): key release sends audioStreamEnd + activityEnd + clientContent.turnComplete.
# true: only the terminator the transcribe docs show per VAD mode (manual -> activityEnd;
# auto/tuned -> audioStreamEnd). May settle faster OR slower - the server currently echoes
# turnComplete, which is an immediate settlement path. Measure both directions.
WS_ENDPOINT_ALIGNED=false

# Streaming Chunk Size (milliseconds)
# Audio is coalesced into frames of this length before dispatch to the Live WebSocket (the
# pre-roll is split the same way). Docs suggest ~100ms for the dedicated transcribe model;
# 150 is the long-shipped value. 20-500. Default: 150.
CHUNK_MS=150

# Trailing Silence Flush (milliseconds)
# Synthetic silence appended after key-up so the speech encoder's lookahead window can
# finalize the last word. Also included in the REST fallback audio. Try 300 or 0 and check
# short final plosives, names, numbers and code-switched endings. 0-2000. Default: 700.
SILENCE_FLUSH_MS=700

# Mic Idle Timeout (seconds)
# Release the microphone (macOS status-bar mic indicator turns off) after this long without a
# dictation. The next key-down re-arms it (~100ms spin-up; the begin sound plays once the mic
# is live, and the first pre-roll after waking is empty). 0 = mic always on (lowest latency).
MIC_IDLE_TIMEOUT=300

# Dictation History (Local SQLite Observability)
# Every dictation (success, empty, or error) is recorded as one row - text, transport, latency
# breakdown, tokens and cost - in a local SQLite DB for later analysis (cost per day, latency
# percentiles, word counts). Stored in PLAINTEXT on this machine only (file mode 0600); set
# HISTORY=false if you don't want dictated text persisted. Query with: sqlite3 ~/.justspeak/history.db
HISTORY=true

# History Database Path (default: ~/.justspeak/history.db - outside the repo, never committed)
HISTORY_DB=

# Analyzer Model (make analyze / --analyze only)
# The model that mines your dictation history for vocabulary suggestions and misrecognition
# fix-up rules. Analysis runs rarely and offline, so a stronger model than the REST fallback
# is worth the few extra cents. Empty = use GEMINI_MODEL.
ANALYZE_MODEL=gemini-3.7-flash

# Analyzer User Context (make analyze / --analyze only)
# One free-text line describing who is dictating, so the analyzer can judge what a garbled
# phrase plausibly meant, e.g.:
#   ANALYZE_CONTEXT="Solutions architect at a cloud provider; daily terms: GCP services, AI products (Claude, Codex, Gemini), customer names"
# Can also live in the vocabulary file as a "# context: ..." line (this knob wins if both set).
ANALYZE_CONTEXT=

# Typed-Correction Capture (opt-in)
# After each paste, read the focused text field back ONCE via the Accessibility API (the
# permission the paste already uses) and diff it against what was pasted. A single-word edit
# you typed ("cloud" -> "Claude") is recorded to the local corrections table as ground truth
# for `make analyze` - nothing is ever auto-applied to your vocabulary. Strictly gated:
# >=3-char real word swaps only, no grammar/capitalization-only fixes, proper-noun or
# known-vocabulary replacements, phonetic (edit-distance) plausibility, max 3 per turn.
# Only the changed word pairs are stored - never the field content. Apps without a usable
# accessibility value (most terminals, some Electron apps) silently learn nothing.
LEARN_CORRECTIONS=false

# Delay (ms) between the paste and the single read-back - you need time to notice and fix
# the error. A new dictation before the timer fires cancels the read. 2000-60000.
LEARN_DELAY_MS=8000

# Token Pricing (USD per 1M tokens)
# Used only for the per-dictation "Tokens & Cost" diagnostics line and the Ctrl+C session
# summary. Defaults match the Aug 2026 public-preview pricing for gemini-3.5-transcribe-live
# (input audio / output text) and gemini-3.5-flash-lite (REST fallback). Update if pricing changes.
LIVE_INPUT_PRICE_PER_1M=3.50
LIVE_OUTPUT_PRICE_PER_1M=21.00
REST_INPUT_PRICE_PER_1M=0.30
REST_OUTPUT_PRICE_PER_1M=2.50

# Diagnostic Log Level
# Options: verbose (detailed latency breakdown and dB meters), normal (concise summary)
LOG_LEVEL=verbose
