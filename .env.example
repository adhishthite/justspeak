# JustSpeak Configuration
# ========================

# Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# REST Fallback Model (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Live WebSocket Model (Real-Time Bidirectional Streaming)
# Dedicated STT Foundation Model: gemini-3.5-transcribe-live
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Smart Transcription (gemini-3.5-transcribe-live only)
# Enables real-time Inverse Text Normalization ($26M, dates), disfluency removal (um/uh), and smart formatting
SMART_TRANSCRIPTION=true

# Language Codes (Target / Prioritized Speech Languages)
# Comma-separated REGION-QUALIFIED BCP-47 codes from the live-transcribe language table,
# e.g. en-IN,mr-IN,hi-IN or en-US,es-ES. Casing is normalized automatically (en-in -> en-IN).
# Default: en-IN,mr-IN (English & Marathi, India). Set to 'auto' for auto-detection (80+ languages).
LANGUAGE_CODES=en-IN,mr-IN

# Custom Vocabulary (Domain terms, acronyms, company jargon, proper nouns)
# Comma-separated list of words/phrases to boost speech recognition accuracy
# An item containing "=>" is a deterministic replacement rule instead of a boost term:
#   cooper netties => Kubernetes
CUSTOM_VOCABULARY=

# Custom Vocabulary File (Optional)
# Relative or absolute path to a text file containing words/phrases (one per line, '#' comments allowed)
# Defaults to auto-loading 'vocabulary.txt' if present in the workspace
CUSTOM_VOCABULARY_FILE=vocabulary.txt

# Push-to-Talk Hotkey
# Options: 
#   - right_option   (Default - Right Option/Alt key, keyCode 61)
#   - left_option    (Left Option/Alt key, keyCode 58)
#   - right_control  (Right Control key, keyCode 62)
#   - left_control   (Left Control key, keyCode 59)
#   - right_cmd      (Right Command key, keyCode 54)
#   - left_cmd       (Left Command key, keyCode 55)
#   - fn             (Fn / Globe key, keyCode 63)
#   - f18            (F18 key, keyCode 0x4F)
#   - f19            (F19 key, keyCode 0x50)
#   - f13            (F13 key, keyCode 0x69)
HOTKEY=right_option

# Hotkey Trigger Mode
# Options:
#   - push_to_talk   (Hold key down to speak, release to commit and inject)
#   - toggle         (Press key once to start recording, press again to stop)
HOTKEY_MODE=push_to_talk

# Audio Feedback
# Play subtle macOS system sounds on recording start and text injection
SOUND_FEEDBACK=true

# Native Floating Pill HUD
# Display a floating glassmorphic Dynamic Island pill overlay on the screen
SHOW_HUD=true

# Real-time WebSocket Streaming
# Stream audio chunks directly to Gemini Live API over WebSockets while speaking
ENABLE_LIVE_WEBSOCKET=true

# Restore Previous Clipboard
# Automatically restore user's previous clipboard contents 150ms after injection
RESTORE_CLIPBOARD=true

# REST Fallback Timeout (seconds)
# Maximum time to wait for WebSocket response before falling back to REST
REST_FALLBACK_TIMEOUT=2.5

# Pre-Roll Buffer (milliseconds)
# Rolling acoustic ring buffer maintained while idle. When the hotkey is pressed, this head-start
# audio is instantly dispatched to prevent clipping the first spoken syllable. 0-1000. Default: 400.
PRE_ROLL_MS=400

# Post-Roll Grace Period (milliseconds)
# Grace period after key release to keep capturing the tail of the final word (people release
# the key while still finishing the last syllable). Lower = faster commit; too low clips the
# final word. 0-500. Default: 250.
POST_ROLL_MS=250

# Voice Activity Detection Mode (Gemini Live)
# Options:
#   - manual  (Default & recommended for push-to-talk: the key hold defines the speech window,
#              server VAD is disabled - a mid-sentence pause can never cut off transcription)
#   - tuned   (Server VAD stays on but is made pause-tolerant via VAD_SILENCE_MS; experimental)
#   - auto    (Stock server VAD; fallback if the model rejects the manual/tuned configuration -
#              a rejection appears as a "[WS] Server error" line in the terminal)
VAD_MODE=manual

# VAD Silence Window (milliseconds, tuned mode only)
# How long a pause must last before server VAD declares end-of-speech. 200-5000.
VAD_SILENCE_MS=1500

# Mic Idle Timeout (seconds)
# Release the microphone (macOS status-bar mic indicator turns off) after this long without a
# dictation. The next key-down re-arms it (~100ms spin-up; the begin sound plays once the mic
# is live, and the first pre-roll after waking is empty). 0 = mic always on (lowest latency).
MIC_IDLE_TIMEOUT=300

# Dictation History (Local SQLite Observability)
# Every dictation (success, empty, or error) is recorded as one row - text, transport, latency
# breakdown, tokens and cost - in a local SQLite DB for later analysis (cost per day, latency
# percentiles, word counts). Stored in PLAINTEXT on this machine only (file mode 0600); set
# HISTORY=false if you don't want dictated text persisted. Query with: sqlite3 ~/.justspeak/history.db
HISTORY=true

# History Database Path (default: ~/.justspeak/history.db - outside the repo, never committed)
HISTORY_DB=

# Token Pricing (USD per 1M tokens)
# Used only for the per-dictation "Tokens & Cost" diagnostics line and the Ctrl+C session
# summary. Defaults match the Aug 2026 public-preview pricing for gemini-3.5-transcribe-live
# (input audio / output text) and gemini-3.5-flash-lite (REST fallback). Update if pricing changes.
LIVE_INPUT_PRICE_PER_1M=3.50
LIVE_OUTPUT_PRICE_PER_1M=21.00
REST_INPUT_PRICE_PER_1M=0.30
REST_OUTPUT_PRICE_PER_1M=2.50

# Diagnostic Log Level
# Options: verbose (detailed latency breakdown and dB meters), normal (concise summary)
LOG_LEVEL=verbose
