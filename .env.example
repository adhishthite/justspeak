# JustSpeak Configuration
# ========================

# Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# REST Fallback Model (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Live WebSocket Model (Real-Time Bidirectional Streaming)
# Dedicated STT Foundation Model: gemini-3.5-transcribe-live
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Smart Transcription (gemini-3.5-transcribe-live only)
# Enables real-time Inverse Text Normalization ($26M, dates), disfluency removal (um/uh), and smart formatting
SMART_TRANSCRIPTION=true

# Language Codes (Target / Prioritized Speech Languages)
# Comma-separated BCP-47 or ISO-639 language codes to prioritize (e.g., en,mr,hi)
# Default: en,mr (English and Marathi). Set to 'auto' for unrestricted auto-detection.
LANGUAGE_CODES=en,mr

# Custom Vocabulary (Domain terms, acronyms, company jargon, proper nouns)
# Comma-separated list of words/phrases to boost speech recognition accuracy
CUSTOM_VOCABULARY=

# Custom Vocabulary File (Optional)
# Relative or absolute path to a text file containing words/phrases (one per line, '#' comments allowed)
# Defaults to auto-loading 'vocabulary.txt' if present in the workspace
CUSTOM_VOCABULARY_FILE=vocabulary.txt

# Push-to-Talk Hotkey
# Options: 
#   - right_option   (Default - Right Option/Alt key, keyCode 61)
#   - left_option    (Left Option/Alt key, keyCode 58)
#   - right_control  (Right Control key, keyCode 62)
#   - left_control   (Left Control key, keyCode 59)
#   - right_cmd      (Right Command key, keyCode 54)
#   - left_cmd       (Left Command key, keyCode 55)
#   - fn             (Fn / Globe key, keyCode 63)
#   - f18            (F18 key, keyCode 0x4F)
#   - f19            (F19 key, keyCode 0x50)
#   - f13            (F13 key, keyCode 0x69)
HOTKEY=right_option

# Hotkey Trigger Mode
# Options:
#   - push_to_talk   (Hold key down to speak, release to commit and inject)
#   - toggle         (Press key once to start recording, press again to stop)
HOTKEY_MODE=push_to_talk

# Audio Feedback
# Play subtle macOS system sounds on recording start and text injection
SOUND_FEEDBACK=true

# Native Floating Pill HUD
# Display a floating glassmorphic Dynamic Island pill overlay on the screen
SHOW_HUD=true

# Real-time WebSocket Streaming
# Stream audio chunks directly to Gemini Live API over WebSockets while speaking
ENABLE_LIVE_WEBSOCKET=true

# Restore Previous Clipboard
# Automatically restore user's previous clipboard contents 150ms after injection
RESTORE_CLIPBOARD=true

# REST Fallback Timeout (seconds)
# Maximum time to wait for WebSocket response before falling back to REST
REST_FALLBACK_TIMEOUT=2.5

# Diagnostic Log Level
# Options: verbose (detailed latency breakdown and dB meters), normal (concise summary)
LOG_LEVEL=verbose
